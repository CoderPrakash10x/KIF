# API base. '/api/v1' = same-origin (dev proxy in vite.config.js, and nginx/Vercel rewrite in production).
# Only use a full URL (https://api.example.com/api/v1) if you deliberately host the API on another site.
VITE_API_BASE_URL=/api/v1
# Dev only: where the Vite proxy forwards /api
DEV_API_TARGET=http://localhost:5001
