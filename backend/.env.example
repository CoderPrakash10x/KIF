# ---------------------------------------------------------------------------
# KIF-RMS Backend — Environment Variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5001

# MongoDB. Transactions REQUIRE a replica set (Atlas works; locally use `docker compose up -d`).
MONGO_URI=mongodb://localhost:27017/kif-rms?replicaSet=rs0&directConnection=true

# Long random secrets, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# SMTP (nodemailer). Emails are best-effort; failures never break a request.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=KIF-RMS <user@example.com>

# Browser origin(s) allowed by CORS (comma-separated). Also used in e-mail links.
FRONTEND_URL=http://localhost:5173

# Optional
COOKIE_DOMAIN=
# strict (same site) | lax | none (frontend and API on different sites; requires HTTPS)
COOKIE_SAMESITE=strict
RATE_LIMIT_MAX=1000

# Optional Cloudinary (profile photo upload). Without it, photo upload returns an error.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed script only (npm run seed / seed:demo). Required in production.
SEED_ADMIN_EMAIL=admin@kif-rms.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Super Admin
SEED_DEMO_PASSWORD=Demo@12345

# --- Registration OTP (e-mail verification) ---------------------------------
# Verification code lifetime, resend cooldown, wrong-guess limit, and sends per hour per account.
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
# Optional separate key for hashing OTPs (defaults to JWT_SECRET). Never commit real values.
OTP_SECRET=
# Never-verified registrations are removed after this many days (frees the e-mail / roll number).
UNVERIFIED_REGISTRATION_TTL_DAYS=7
